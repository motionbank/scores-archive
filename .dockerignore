# Keep build context small — only the site itself is needed in the image.
.git
.idea
*.md
Dockerfile
.dockerignore
docker/*
# Media (~7 GB) lives on an external drive; `media/` is a symlink to it.
# It is NOT baked into the image — mount it at runtime:
#   docker run -v "/Volumes/ScratchDiks/motionbank-media:/usr/share/nginx/html/media:ro" …
media
!docker/nginx-default.conf
!docker/ssl
