somewhere-beyond-the-stage","class":"no-description"},"id":"b6d6979d6d303442a31d0000","poster_image":{"url":"/system/uploads/jbmf/GridCell/poster_image/full/somewhere.jpg","small":{"url":"/system/uploads/jbmf/GridCell/poster_image/small/somewhere.jpg"},"medium":{"url":"/system/uploads/jbmf/GridCell/poster_image/medium/somewhere.jpg"}},"x":6,"y":7,"width":2,"height":3},{"title":"This Is Treeson!","description":"","type":"set_link","additional_fields":{"set-id":"this-is-treeson","class":"no-description"},"id":"05e8979d6d303442a31e0000","poster_image":{"url":"/system/uploads/jbmf/GridCell/poster_image/full/treeson.jpg","small":{"url":"/system/uploads/jbmf/GridCell/poster_image/small/treeson.jpg"},"medium":{"url":"/system/uploads/jbmf/GridCell/poster_image/medium/treeson.jpg"}},"x":2,"y":7,"width":2,"height":3},{"title":"Watcha Looking At?","description":"","type":"set_link","additional_fields":{"set-id":"watcha-looking-at","class":"no-description"},"id":"0dff979d6d303442a31f0000","poster_image":{"url":"/system/uploads/jbmf/GridCell/poster_image/full/watcha.jpg","small":{"url":"/system/uploads/jbmf/GridCell/poster_image/small/watcha.jpg"},"medium":{"url":"/system/uploads/jbmf/GridCell/poster_image/medium/watcha.jpg"}},"x":6,"y":1,"width":2,"height":3},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h1>Meanwhile in parallel worlds …</h1><p>The scenes on this page were developed from the patterns both within the duets of Jonathan and Matteo and their working process. See the Interview Set <a href=\"#/set/patterns-and-pulse\">Patterns & Pulse</a> for a detailed overview of this research.</p><p>Each scene consists of a pattern 'generator' and a 'performer' (or two) who express these patterns.</p><p>Pulses sent from the 'generator' trigger the movements of the 'performer'. For example: in WHATCHA LOOKING AT? the hand claps are triggering the movements of the 'performer'.</p><p>A row of buttons [0-19] [PLAY] [STOP] is an invitation to change the relationships you are perceiving (piano pieces by Matteo Fargion).</p>","css-color":"black"},"id":"4b15d09d6d303442a0200000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":0,"y":0,"width":4,"height":4},{"title":"Link to Tutorials","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h1><a href=\"http://motionbank.org/de/event/online-scores-tutorial\" target=\"_blank\">LINK TO TUTORIALS</a></h1><p>Find a video explanation about the creation of the Parallel Worlds 'performers' and 'generators' here.</p>","class":"text-dark"},"id":"53b645476d30347d6e460000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":8,"y":7,"width":2,"height":2}]}