0fcda0a4c5e44.png"}},"x":26,"y":8,"width":3,"height":1},{"title":"Armed Vase","description":"","type":"iframe","additional_fields":{"iframe-src":"/modules/jbmf/performer/Vase_refined/","class":"no-loading-ani"},"id":"533325a76d3034795d2a0000","poster_image":{"url":"/system/uploads/jbmf/Cell/poster_image/full/Screen_Shot_2013-11-27_at_7.51.19_PM.png","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/Screen_Shot_2013-11-27_at_7.51.19_PM.png"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/Screen_Shot_2013-11-27_at_7.51.19_PM.png"}},"x":18,"y":4,"width":5,"height":8},{"title":"Hand clapper","description":"Generator","type":"iframe","additional_fields":{"iframe-src":"/modules/jbmf/generators/05_clap/index.html","autoload":"true","class":"no-loading-ani"},"id":"533325ce6d30347960260000","poster_image":{"url":"/system/uploads/jbmf/Cell/poster_image/full/Screen_Shot_2013-11-19_at_9.12.23_PM.png","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/Screen_Shot_2013-11-19_at_9.12.23_PM.png"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/Screen_Shot_2013-11-19_at_9.12.23_PM.png"}},"x":23,"y":5,"width":1,"height":4},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h2>Choreographer Jonathan Burrows and Composer Matteo Fargion bring their body of work to Motion Bank.</h2><p>Many selected fragments from duets made over ten years have been recorded with the aim to \"read the links between them... \" (Jonathan Burrows).</p>"},"id":"5333c49f6d30347960280000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":3,"y":3,"width":3,"height":4},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h2>This material has been expanded with a collection of 'generators' and 'performers' based on insights gained into the creation process of Burrows and Fargion.</h2><p>Included alongside this collection are full performance recordings of all seven duets, score notebooks and interview material.</p><p>For reports from the Motion Bank research process behind all materials published here, click on this link to the <a href=\"http://motionbank.org/en/content/jonathan-burrows-matteo-fargion\" target=\"_blank\">documentation</a> or go to a short <a href=\"http://motionbank.org/en/event/online-scores-tutorial\" target=\"_blank\">video tour</a> of SEVEN DUETS.</p>"},"id":"5333c5186d30347960290000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":7,"y":7,"width":3,"height":5},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h2>\"When a performer reads their score during the performance, it can help mediate between them and the audience.\"</h2><p>A Choreographer's Handbook, Jonathan Burrows. p. 143.</p>"},"id":"5333df9a6d30347966320000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":13,"y":2,"width":3,"height":3},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h2>\"Our tendency is to want to call everything score. This is good if we recognise that score is nothing.\"</h2><p>Rebelling Against Limit, lecture concert, Jonathan Burrows & Matteo Fargion</p>"},"id":"5333ea186d30347966330000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":15,"y":8,"width":3,"height":3},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h2>'Fragments' are everywhere on this website: short interview clips are linked together, parts & pieces of things are shown, sequences are composed, demonstrations are made, names contribute to an emerging lexicon.</h2><p>Sometimes relationships are constructed. Other objects appear isolated, but available for connections to be made. References to outside materials and links back to research questions are on offer. Original recordings - processed and analysed - produce second order study objects... </p>"},"id":"5333f05d6d3034795d2d0000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":18,"y":1,"width":6,"height":4},{"title":"click on the titles below the images","description":"","type":"title","additional_fields":{"css-display":"none"},"id":"5333f4c66d303479602a0000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":1,"y":3,"width":2,"height":2},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<p>\"We have the idea of building something which contradicts the usual horizontal nature of websites... \". From an email 26 July 2011 from Jonathan Burrows & Matteo Fargion following their <a href=\"http://motionbank.org/en/event/jonathan-burrows-matteo-fargion-research-sessions\" target=\"_blank\">first meeting</a> with Nik Haffner in Brussels.</p>"},"id":"53352dc36d30347963330000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":24,"y":9,"width":3,"height":3},{"title":"Paperboy","description":"Performer","type":"iframe","additional_fields":{"iframe-src":"/modules/jbmf/performer/paperboy_05/","autoload":"true","class":"no-loading-ani","click-through":"1","css-z-index":"-100"},"id":"533667266d30347963370000","poster_image":{"url":"/system/uploads/jbmf/Cell/poster_image/full/Screen_Shot_2013-11-19_at_9.20.25_PM.png","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/Screen_Shot_2013-11-19_at_9.20.25_PM.png"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/Screen_Shot_2013-11-19_at_9.20.25_PM.png"}},"x":0,"y":4,"width":8,"height":9},{"title":"Hand clapper","description":"Generator","type":"iframe","additional_fields":{"iframe-src":"/modules/jbmf/generators/05_clap/index.html","autoload":"true","class":"no-loading-ani"},"id":"533667636d30347960310000","poster_image":{"url":"/system/uploads/jbmf/Cell/poster_image/full/Screen_Shot_2013-11-19_at_9.12.23_PM.png","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/Screen_Shot_2013-11-19_at_9.12.23_PM.png"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/Screen_Shot_2013-11-19_at_9.12.23_PM.png"}},"x":1,"y":8,"width":1,"height":4},{"title":"Patterns & Pulse","description":"","type":"set_link","additional_fields":{"set-id":"fa8231756d3034219c060000"},"id":"53367a646d30347960340000","poster_image":{"url":"/assets/fallback/default-cdee06016c