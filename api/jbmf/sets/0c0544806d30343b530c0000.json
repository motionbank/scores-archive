8378-640.jpg","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/vimeo-68204508-441868378-640.jpg"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/vimeo-68204508-441868378-640.jpg"}},"x":8,"y":6,"width":4,"height":4},{"title":"continue with \"On Material\" Set","description":"","type":"set_link","additional_fields":{"set-id":"4319a0846d30343b592e0000"},"id":"533548906d3034795d2e0000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":28,"y":1,"width":3,"height":1},{"title":"continue with \"don't feed the what\" set (Parallel Worlds)","description":"","type":"set_link","additional_fields":{"set-id":"6a06b29a6d3034429d130000"},"id":"53354de36d30347966350000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":28,"y":2,"width":3,"height":1},{"title":"PROTO HTML cell","description":"A recording of Jonathan Burrows & Matteo Fargion piece \"Both Sitting Duet\", performed in the Frankfurt LAB on the 23rd of September 2012.","type":"html","additional_fields":{"html-content":"<h1>Both Sitting Duet (2002)</h1><h2>\"The piece is performed sitting down, in silence. The choice to sit down was made in order that the two performers, one a composer and the other a choreographer, could be seen either as musicians or as dancers.\"</h2><p>from the text about the piece on Jonathan Burrows' <a href=\"http://www.jonathanburrows.info/#/score/?id=5&t=content\" target=\"_blank\">website</a>, <a href=\"#/set/score-books/both-sitting-duet\">View Score Book</a></p>"},"id":"53354e7d6d303479602f0000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":4,"y":7,"width":4,"height":4},{"title":"\"The Quiet Dance\" (2005)","description":"Film by Hugo Glendinning.","type":"vimeo","additional_fields":{"vimeo-id":"78514968","class":"show-info"},"id":"533652a76d3034795d2f0000","poster_image":{"url":"/system/uploads/jbmf/Cell/poster_image/full/screen-shot-2013-11-19-at-1.01.36-pm.png","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/screen-shot-2013-11-19-at-1.01.36-pm.png"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/screen-shot-2013-11-19-at-1.01.36-pm.png"}},"x":18,"y":6,"width":4,"height":4},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h1>The Quiet Dance (2005)</h1><h2>\"The piece is made up of ten sections, built of various and repeating materials, with each section separated by the performers clapping their hands and then resting. The score for the piece shows these materials as a list of names, separated into blocks by a short gap.\"</h2><p>From the text about the piece on Jonathan Burrows' <a href=\"http://www.jonathanburrows.info/#/score/?id=4&t=content\" target=\"_blank\">website</a>. <a href=\"#/set/score-books/quiet-dance\">View Score Book</a></p>"},"id":"5336542f6d3034795d300000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":14,"y":7,"width":4,"height":4},{"title":"\"Speaking Dance\" (2006)","description":"Performed at The Frankfurt LAB 22 September 2012","type":"vimeo","additional_fields":{"vimeo-id":"68859413","class":"show-info"},"id":"53365e986d30347963360000","poster_image":{"url":"/system/uploads/jbmf/Cell/poster_image/full/screen-shot-2013-11-19-at-1.02.03-pm.png","small":{"url":"/system/uploads/jbmf/Cell/poster_image/small/screen-shot-2013-11-19-at-1.02.03-pm.png"},"medium":{"url":"/system/uploads/jbmf/Cell/poster_image/medium/screen-shot-2013-11-19-at-1.02.03-pm.png"}},"x":27,"y":6,"width":4,"height":4},{"title":"PROTO HTML cell","description":"Use this cell to put HTML content into a set","type":"html","additional_fields":{"html-content":"<h1>Speaking Dance (2006)</h1><h2>\"The opening of Speaking Dance is a rapid counterpoint of loosely connected words, written around the idea of describing a dance that you can hear but never see.\"</h2><p>From the text about the piece on Jonathan Burrows' <a href=\"http://www.jonathanburrows.info/#/score/?id=3&t=content\" target=\"_blank\">website</a>. <a href=\"#/set/score-books/speaking-dance\">View Score Book</a></p>"},"id":"53365ed36d30347960300000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":24,"y":7,"width":3,"height":4}]}