wfullscreen":"mozallowfullscreen","attr-webkitallowfullscreen":"webkitallowfullscreen"},"id":"5350b3f86d30347d74040000","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/record-0c-1.jpg","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/record-0c-1.jpg"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/record-0c-1.jpg"}},"x":9,"y":5,"width":1,"height":1},{"title":"April 2011, Day 3, Take 2, Juliette Mapp","description":"This recording shows Juliette Mapp performing the solo \"No Time To Fly\".","type":"recording","additional_fields":{"iframe-src":"/dh/dhay/player/?rec=D03T02&vid=69389&file=D03T02_Juliette_sync_Center_Small&gid=24&perf=juliettemapp","autoload":"0","solo":"24","attr-allowfullscreen":"allowfullscreen","attr-mozallowfullscreen":"mozallowfullscreen","attr-webkitallowfullscreen":"webkitallowfullscreen"},"id":"5350b4276d30347d74050000","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/record-8c-1.jpg","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/record-8c-1.jpg"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/record-8c-1.jpg"}},"x":7,"y":2,"width":2,"height":2},{"title":"April 2011, Day 6, Take 3, Jeanine Durning","description":"This recording shows Jeanine Durning performing the solo \"No Time To Fly\".","type":"recording","additional_fields":{"iframe-src":"/dh/dhay/player/?rec=D06T03&vid=69400&file=D06T03_Janine_sync_Center_Small&gid=24&perf=jeaninedurning","autoload":"0","solo":"24"},"id":"5350b4396d30347d71000000","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/record-19c-1.jpg","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/record-19c-1.jpg"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/record-19c-1.jpg"}},"x":6,"y":0,"width":1,"height":1},{"title":"April 2011, Day 4, Take 2, Juliette Mapp","description":"This recording shows Juliette Mapp performing the solo \"No Time To Fly\".","type":"recording","additional_fields":{"iframe-src":"/dh/dhay/player/?rec=D04T02&vid=69394&file=D04T02_Juliette_sync_Center_Small&gid=24&perf=juliettemapp","autoload":"0","solo":"24","attr-allowfullscreen":"allowfullscreen","attr-mozallowfullscreen":"mozallowfullscreen","attr-webkitallowfullscreen":"webkitallowfullscreen"},"id":"5350b4656d30347d74060000","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/record-12c-1.jpg","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/record-12c-1.jpg"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/record-12c-1.jpg"}},"x":9,"y":3,"width":1,"height":1},{"title":"Welcome text","description":"","type":"html","additional_fields":{"html-content":"<h1>Welcome!</h1><p>This set gives you a quick introduction into how USING THE SKY works.<br/><br/>Everything is based on Deborah Hay's written score 'No Time to Fly'. This score was sent to Ros Warby, Jeanine Durning and Juliette Mapp with instructions to practice it alone for three months to create their own solo adaptations. The seven recordings of each adaptation provide the core content for this website. The score determines the sequence of the dance, and this sequence is divided into 25 different parts.<br/><br/>You will find this score text throughout this website with tab numbers (1-29) running down the right side. Tabs 1-4 include the pages with FOUR QUESTIONS and REMINDERS for the dancer. Juliette Mapp's solo adaptation always begins at tab 7.</br></br><strong>Horizontal Scrolling:</strong> Use the arrow keys or the browser scrollbar at the bottom of the site to move left and right through material. There are additional buttons to click along the sides and bottom of the site.</p>"},"id":"5350fd3f6d30347d71040000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":0,"y":0,"width":2,"height":5},{"title":"Nav recs text","description":"","type":"html","additional_fields":{"html-content":"<h1>Navigating recordings</h1><p>Start a recording video by clicking it. Once the recording plays the other recording cells will receive its time and adapt to it. Click Ros Warby above, watch for a while (46 seconds to be precise) and observe the inter-relations in effect.</p>"},"id":"5350fdc06d30347d71050000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":3,"y":4,"width":2,"height":2},{"title":"Navigating the Score","description":"","type":"html","additional_fields":{"html-content":"<h1>Navigating the Score</h1><p>The score text (the <a href=\"#/set/jeanine-ros-insights\"> insights</a> text also) adapts to any running recording by showing its appropriate section.<br/><br/>You can also use the score to navigate any material that relates to it, for example the recordings and visualisations. Just click any of the tabs to see the inter-relations. Try this with the score text to the right.</p>"},"id":"5350fdf36d30347d71060000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":7,"y":0,"width":3,"height":2},{"title":"Resizing & scrolling text","description":"","type":"html","additional_fields":{"html-content":"<h1>RESIZING & SCROLLING</h1><p>You can also see recordings in full screen by clicking the upper right corner.<br/><br/> If you scroll the screen too far left or right the recording will stop. This is to reduce the amount of video streaming the website has to handle.</p>"},"id":"535179896d30347d710f0000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":7,"y":4,"width":2,"height":2},{"title":"Score text","description":"","type":"iframe","additional_fields":{"iframe-src":"http://lab.motionbank.org/dhay/text/score-text.html"},"id":"53517b6e6d30347d740e0000","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/screen-shot-2013-05-18-at-9.39.08-am-2.png","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/screen-shot-2013-05-18-at-9.39.08-am-2.png"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/screen-shot-2013-05-18-at-9.39.08-am-2.png"}},"x":10,"y":1,"width":2,"height":5},{"title":"Cell Info Information and Videos stopping","description":"","type":"html","additional_fields":{"html-content":"<h1>INFO & ONE AT A TIME</h1><p>To find out what is in the content of each cell, roll over that cell with the mouse or click on SHOW INFO in the drop down menu above (HIDE INFO takes it away).<br/><br/>You will not be able to play two recordings at the same time. This is also to reduce the amount of video streaming the website has to handle.</p>"},"id":"53517e4a6d30347d71100000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":13,"y":0,"width":2,"height":2},{"title":"Segment probability Juliette Mapp","description":"","type":"visualization","additional_fields":{"base-path":"scene-probability/one-perf-all-recs-one-scene/juliettemapp_","per-scene":"true"},"id":"53517f0d6d30347d71110000","poster_image":{"url":"/system/uploads/debor