borah_hay/Cell/poster_image/small/hull-all-takes-market-traditional-object.png"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/hull-all-takes-market-traditional-object.png"}},"x":12,"y":0,"width":4,"height":5},{"title":"Score text","description":"","type":"iframe","additional_fields":{"iframe-src":"/dh/dhay/text/score-text.html"},"id":"506f5f716d6d6d8d05080200","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/screen-shot-2013-05-18-at-9.39.08-am-2.png","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/screen-shot-2013-05-18-at-9.39.08-am-2.png"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/screen-shot-2013-05-18-at-9.39.08-am-2.png"}},"x":6,"y":0,"width":2,"height":5},{"title":"Full travel path Juliette Mapp all 7 recordings","description":"This image shows the travel path of 7 performances of No Time To Fly (April 2011) at once.","type":"visualization","additional_fields":{"fixed-image":"travel-path/one-perf-all-recs-all-scenes/path_juliettemapp_all-takes_all.png"},"id":"566f5f716d6d6d8d05090200","poster_image":{"url":"/system/uploads/deborah_hay/Cell/poster_image/full/path-juliettemapp-all-takes-all-1.png","small":{"url":"/system/uploads/deborah_hay/Cell/poster_image/small/path-juliettemapp-all-takes-all-1.png"},"medium":{"url":"/system/uploads/deborah_hay/Cell/poster_image/medium/path-juliettemapp-all-takes-all-1.png"}},"x":2,"y":0,"width":4,"height":5},{"title":"Intro text","description":"","type":"html","additional_fields":{"html-content":"<h1>Movement character</h1><p>This set tries to lay focus on two aspects of character in regard to the 21 travel path datasets generated from the April 2011 No Time To Fly recordings. <br/><br/>The first aspect is the character of the drawing that becomes visible when the travel path data is put into relation to the score. <br/></br>The second is the character of the dancers choices in regard to location and space that shine through in the data visualizations.<br/><br/>A <b>travel path</b> in our dataset is a track generated from connecting 2D points over stage that are calculated from the the center of the performer (read more in <a href=\"http://motionbank.org/en/event/deborah-hay-score-project-solo-filming\" target=\"_blank\">score process documentation</a>).<br/><br/> Each performer is represented by a colour: Ros Warby (blue), Juliette Mapp (green), Jeanine Durning (red)</p>"},"id":"534ab9926d30347966710000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":0,"y":0,"width":2,"height":5},{"title":"Convex hull text","description":"","type":"html","additional_fields":{"html-content":"<h1>Convex hull</h1><p>The visualization above shows \"convex hulls\" of the travel paths in relation to the score. A <b>convex hull</b> is a shape formed by connecting the outmost points of a dataset like a rubber band that is wrapped around it.</p>"},"id":"534ac45c6d30347963610000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e44.png"}},"x":12,"y":5,"width":4,"height":2},{"title":"Use of space tab nums text","description":"","type":"html","additional_fields":{"html-content":"<h1>Use of space</h1><p>Try tab numbers: 7, 11, 14, 18, 21, 23, 25, 26 and compare location and use of space in the visualizations to the right</p>"},"id":"534ac58f6d30347966720000","poster_image":{"url":"/assets/fallback/default-cdee06016c3ca15e5810fcda0a4c5e44.png","small":{"url":"/assets/fallback/small_default-b553e49f4bf6795c93d62ecc6a576ac4.png"},"medium":{"url":"/assets/fallback/medium_default-cdee06016c3ca15e5810fcda0a4c5e4